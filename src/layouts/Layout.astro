---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaraMobila from "../components/BaraMobila.astro";
import BannerCookies from "../components/BannerCookies.astro";
import { site, u } from "../data/site";
import { grafCabinet, grafIntrebari } from "../data/schema";

interface Props {
  title: string;
  description: string;
  // paginile cu întrebări frecvente trimit lista aici, ca să intre și în datele structurate
  intrebari?: { q: string; a: string }[];
  // pentru paginile care nu trebuie indexate cât timp blogul stă nepublicat
  noindex?: boolean;
  // date structurate suplimentare, de exemplu BlogPosting pe pagina de articol
  schemaSuplimentar?: Record<string, unknown>;
}

const { title, description, intrebari, noindex, schemaSuplimentar } = Astro.props;

const baza = Astro.site ?? new URL(Astro.url.origin);
// Varianta de previzualizare stă pe github.io. Nu trebuie indexată: altfel Google
// ajunge să arate demo-ul în loc de site-ul de pe domeniul clientei.
const estePreviz = baza.hostname.endsWith("github.io");
const paginaUrl = new URL(Astro.url.pathname, baza).href;
const ogImagine = new URL(u("/images/og.jpg"), baza).href;

const dateStructurate = {
  "@context": "https://schema.org",
  "@graph": [
    ...grafCabinet(baza),
    ...(intrebari ? [grafIntrebari(intrebari)] : []),
    ...(schemaSuplimentar ? [schemaSuplimentar] : []),
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="canonical" href={paginaUrl} />
    {estePreviz && <meta name="robots" content="noindex, nofollow" />}
    {!estePreviz && noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#e4f1eb" />

    <!-- previzualizarea linkului pe WhatsApp și Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={`Cabinet de psihologie ${site.nume}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={ogImagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Copil jucându-se cu un cub de sortat forme în cabinetul de psihologie"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(dateStructurate)} is:inline />
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-clay focus:px-4 focus:py-2 focus:text-white"
      >Sari la conținut</a
    >
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <!-- spațiu cât bara fixă de pe mobil, ca să nu acopere footerul -->
    <div class="h-[4.6rem] md:hidden" aria-hidden="true"></div>
    <BaraMobila />
    <BannerCookies />
  </body>
</html>
