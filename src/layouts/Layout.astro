---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaraMobila from "../components/BaraMobila.astro";
import { site, u } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const baza = Astro.site ?? new URL(Astro.url.origin);
const paginaUrl = new URL(Astro.url.pathname, baza).href;
const ogImagine = new URL(u("/images/og.jpg"), baza).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="canonical" href={paginaUrl} />
    <meta name="theme-color" content="#e4f1eb" />

    <!-- previzualizarea linkului pe WhatsApp și Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={`Cabinet de psihologie ${site.nume}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={ogImagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Copil jucându-se cu un cub de sortat forme în cabinetul de psihologie"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-clay focus:px-4 focus:py-2 focus:text-white"
      >Sari la conținut</a
    >
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <!-- spațiu cât bara fixă de pe mobil, ca să nu acopere footerul -->
    <div class="h-[4.6rem] md:hidden" aria-hidden="true"></div>
    <BaraMobila />
  </body>
</html>
