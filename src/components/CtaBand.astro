---
import { site, waLink } from "../data/site";

interface Props {
  titlu?: string;
  text?: string;
}

// Titlul, fraza de deschidere și textul sunt ale clientei: „În loc de programări:
// Contact. Primul pas e un mesaj" (25 octombrie, 22:03) și frazele despre contact
// și programare din 20 și 23 octombrie. Banda stă pe verde închis, tot la cererea
// ei, ca să iasă în evidență.
const {
  titlu = "Contact",
  text = "Mă pot contacta direct prin telefon sau WhatsApp. Toate vizitele în cadrul cabinetului se fac exclusiv cu programare prealabilă, pentru a asigura un mediu liniștit și atenție deplină fiecărui copil.",
} = Astro.props;
---

<section class="bg-mint-900 text-white">
  <div class="wrap grid gap-8 py-14 md:grid-cols-[1.3fr_1fr] md:items-center md:py-20">
    <div>
      <h2 class="h2">{titlu}</h2>
      <p class="lead mt-3 font-serif text-white">Primul pas e un mesaj.</p>
      <p class="mt-4 max-w-xl text-[1rem] text-mint-200">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap md:flex-col md:items-end">
      <a
        class="btn btn-light"
        href={waLink("Bună ziua, aș dori să discutăm despre o programare.")}
        target="_blank"
        rel="noopener">Scrieți pe WhatsApp</a
      >
      <a class="btn btn-outline-light" href={`tel:${site.telefon.replace(/\s/g, "")}`}
        >Sunați la {site.telefonAfisat}</a
      >
    </div>
  </div>
</section>
