---
import { site, waLink } from "../data/site";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 backdrop-blur md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
>
  <div class="grid grid-cols-2 gap-2 px-4 py-2.5">
    <a
      class="btn btn-whatsapp w-full"
      href={waLink("Bună ziua, aș dori o programare pentru copilul meu.")}
      target="_blank"
      rel="noopener"
    >
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.8 9.8 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.06c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.13.07-1.82-.11a16.5 16.5 0 0 1-1.65-.61c-2.9-1.25-4.8-4.18-4.94-4.37-.15-.2-1.19-1.58-1.19-3.02 0-1.43.75-2.14 1.02-2.43.27-.29.58-.36.78-.36l.56.01c.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.2-.15.32-.29.49-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.68-.17 1.36Z"
        ></path>
      </svg>
      WhatsApp
    </a>
    <a class="btn btn-ghost w-full bg-paper" href={`tel:${site.telefon.replace(/\s/g, "")}`}>
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
        <path
          d="M6.6 2h2.2c.5 0 .93.34 1.05.83l.8 3.2c.1.42-.04.86-.37 1.13l-1.4 1.16a13.4 13.4 0 0 0 5.8 5.8l1.16-1.4c.27-.33.71-.47 1.13-.37l3.2.8c.49.12.83.55.83 1.05v2.2c0 1.1-.9 2-2 2C10.5 18.4 5.6 13.5 4.6 4c0-1.1.9-2 2-2Z"
        ></path>
      </svg>
      Sunați
    </a>
  </div>
</div>
