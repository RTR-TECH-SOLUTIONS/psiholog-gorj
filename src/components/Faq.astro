---
interface Props {
  intrebari: { q: string; a: string }[];
}
const { intrebari } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    intrebari.map((item) => (
      <details class="group py-5">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 text-[1.08rem] leading-snug"
        >
          <span class="font-serif">{item.q}</span>
          <span
            aria-hidden="true"
            class="mt-1 shrink-0 text-mint-700 transition-transform duration-200 group-open:rotate-45"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 max-w-2xl pr-10 text-ink-soft">{item.a}</p>
      </details>
    ))
  }
</div>
