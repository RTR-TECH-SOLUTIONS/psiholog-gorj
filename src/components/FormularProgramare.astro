---
import { site, u } from "../data/site";

// Formularul cerut de clientă pe 27 octombrie, la 20:38 („Ar trebui și un formular?"), cu
// macheta trimisă la 20:55: patru câmpuri, informarea privind prelucrarea datelor sub ultimul
// chenar și butonul „Trimite solicitarea". Mesajul de confirmare e cel cerut de ea la 20:44.
//
// Formularul NU trimite nimic către un server: la apăsarea butonului, răspunsurile sunt puse
// într-un mesaj WhatsApp, în browserul părintelui, iar mesajul pleacă doar dacă îl trimite el
// din WhatsApp. Așa, site-ul rămâne fără colectare de date (art. 12.1 din contract) și nu
// apare niciun furnizor nou în politica de confidențialitate.
// TODO(real): când site-ul trece pe psihologgorj.ro, pe găzduire cu PHP, formularul poate
// trimite direct un e-mail către cabinet. Atunci confirmarea devine exact fraza clientei:
// „Solicitarea dumneavoastră a fost transmisă."
---

<section id="programare" class="scroll-mt-28 border-t border-line bg-cream py-16 md:py-20">
  <div class="wrap grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <h2 class="h2 max-w-[14ch]">Solicitați o programare</h2>
      <p class="mt-5 text-ink-soft">
        Scrieți-mi în câteva rânduri despre copilul dumneavoastră. Când apăsați butonul, mesajul
        se deschide gata scris în WhatsApp, iar dumneavoastră doar îl trimiteți.
      </p>
      <p class="mt-4 text-ink-soft">
        Dacă vă e mai ușor, sunați-mă la <a
          class="link-u"
          href={`tel:${site.telefon.replace(/\s/g, "")}`}>{site.telefonAfisat}</a
        >, luni până vineri, între 16:00 și 20:00.
      </p>
    </div>

    <div class="rounded-card border border-line bg-blush p-5 md:p-7">
      <form id="formular-programare" novalidate data-wa={site.whatsapp}>
        <div class="grid gap-3.5">
          <div
            id="cutie-nume"
            class="rounded-[12px] border border-line bg-paper px-4 py-3 transition-colors duration-200 focus-within:border-cocoa"
          >
            <label class="block font-serif text-[1.05rem] text-ink" for="camp-nume"
              >Numele părintelui / persoanei</label
            >
            <input
              id="camp-nume"
              name="nume"
              type="text"
              autocomplete="name"
              aria-describedby="eroare-nume"
              class="mt-1 w-full bg-transparent text-[1rem] text-ink placeholder:text-ink-soft/65 focus:outline-none"
              placeholder="Scrieți numele aici"
            />
          </div>
          <p id="eroare-nume" hidden class="-mt-2 text-[0.88rem] text-[#a2402e]"></p>

          <div
            class="rounded-[12px] border border-line bg-paper px-4 py-3 transition-colors duration-200 focus-within:border-cocoa"
          >
            <label class="block font-serif text-[1.05rem] text-ink" for="camp-varsta"
              >Vârsta copilului / persoanei</label
            >
            <input
              id="camp-varsta"
              name="varsta"
              type="text"
              class="mt-1 w-full bg-transparent text-[1rem] text-ink placeholder:text-ink-soft/65 focus:outline-none"
              placeholder="Ex.: 6 ani"
            />
          </div>

          <div
            id="cutie-telefon"
            class="rounded-[12px] border border-line bg-paper px-4 py-3 transition-colors duration-200 focus-within:border-cocoa"
          >
            <label class="block font-serif text-[1.05rem] text-ink" for="camp-telefon"
              >Număr de telefon</label
            >
            <input
              id="camp-telefon"
              name="telefon"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              aria-describedby="eroare-telefon"
              class="mt-1 w-full bg-transparent text-[1rem] text-ink placeholder:text-ink-soft/65 focus:outline-none"
              placeholder="Numărul la care vă pot contacta"
            />
          </div>
          <p id="eroare-telefon" hidden class="-mt-2 text-[0.88rem] text-[#a2402e]"></p>

          <div
            class="rounded-[12px] border border-line bg-paper px-4 py-3 transition-colors duration-200 focus-within:border-cocoa"
          >
            <label class="block font-serif text-[1.05rem] text-ink" for="camp-descriere"
              >Scurtă descriere a dificultăților</label
            >
            <textarea
              id="camp-descriere"
              name="descriere"
              rows="4"
              class="mt-1 w-full resize-y bg-transparent text-[1rem] leading-relaxed text-ink placeholder:text-ink-soft/65 focus:outline-none"
              placeholder="Descrieți pe scurt motivul pentru care solicitați sprijin..."></textarea>
          </div>
        </div>

        {/* Informarea privind prelucrarea datelor, cerută de clientă la 20:52: „Lângă formular". */}
        <p class="mt-5 text-[0.9rem] leading-relaxed text-ink-soft">
          Datele completate vor fi utilizate pentru a răspunde solicitării și pentru a vă contacta
          în vederea unei programări. Formularul deschide o conversație pe WhatsApp, iar site-ul nu
          păstrează nimic din ce scrieți aici. Pentru detalii, consultați <a
            class="link-u"
            href={u("/confidentialitate")}>Politica de confidențialitate</a
          >.
        </p>

        <button type="submit" class="btn btn-primary mt-5 w-full">Trimite solicitarea</button>
      </form>

      {/* Focalizarea e programatică, doar ca tastatura să continue de aici; conturul de focus
          ar desena o ramă în jurul unui bloc pe care nimeni nu l-a selectat, deci îl scoatem. */}
      <div
        id="confirmare-programare"
        hidden
        role="status"
        aria-live="polite"
        tabindex="-1"
        class="focus:outline-none"
      >
        <p class="font-serif text-[1.3rem] text-cocoa">Solicitarea dumneavoastră este gata.</p>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Am deschis WhatsApp cu mesajul completat. Apăsați <strong class="font-medium text-ink"
            >Trimite</strong
          > acolo, iar eu vă contactez pentru a discuta detaliile programării.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <a id="reia-whatsapp" class="btn btn-whatsapp" href="#" target="_blank" rel="noopener"
            >Deschideți din nou WhatsApp</a
          >
          <a class="btn btn-ghost" href={`tel:${site.telefon.replace(/\s/g, "")}`}
            >Sunați la {site.telefonAfisat}</a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("formular-programare") as HTMLFormElement | null;
  const confirmare = document.getElementById("confirmare-programare");
  const reia = document.getElementById("reia-whatsapp") as HTMLAnchorElement | null;

  if (form && confirmare && reia) {
    const numar = form.dataset.wa ?? "";

    const camp = (nume: string) =>
      form.elements.namedItem(nume) as HTMLInputElement | HTMLTextAreaElement | null;

    // chenarul greșit se vede și fără focus, nu doar prin mesajul de dedesubt
    const ROSU = "border-[#a2402e]";

    const arataEroare = (nume: string, text: string) => {
      const p = document.getElementById(`eroare-${nume}`);
      if (p) {
        p.textContent = text;
        p.hidden = false;
      }
      document.getElementById(`cutie-${nume}`)?.classList.add(ROSU);
      camp(nume)?.setAttribute("aria-invalid", "true");
    };

    const ascundeEroare = (nume: string) => {
      const p = document.getElementById(`eroare-${nume}`);
      if (p) p.hidden = true;
      document.getElementById(`cutie-${nume}`)?.classList.remove(ROSU);
      camp(nume)?.removeAttribute("aria-invalid");
    };

    // cum începe să scrie, eroarea dispare
    for (const nume of ["nume", "telefon"]) {
      camp(nume)?.addEventListener("input", () => ascundeEroare(nume));
    }

    form.addEventListener("submit", (ev) => {
      ev.preventDefault();

      const nume = camp("nume")?.value.trim() ?? "";
      const varsta = camp("varsta")?.value.trim() ?? "";
      const telefon = camp("telefon")?.value.trim() ?? "";
      const descriere = camp("descriere")?.value.trim() ?? "";

      let primulGresit: HTMLElement | null = null;

      if (nume.length < 2) {
        arataEroare("nume", "Scrieți-mi numele dumneavoastră, ca să știu cum să vă răspund.");
        primulGresit = camp("nume");
      } else {
        ascundeEroare("nume");
      }

      // un număr de telefon românesc are cel puțin 9 cifre, cu sau fără prefix
      if (telefon.replace(/\D/g, "").length < 9) {
        arataEroare("telefon", "Scrieți un număr de telefon la care vă pot suna.");
        if (!primulGresit) primulGresit = camp("telefon");
      } else {
        ascundeEroare("telefon");
      }

      if (primulGresit) {
        primulGresit.focus();
        return;
      }

      const randuri = [
        "Bună ziua, aș dori o programare.",
        `Nume: ${nume}`,
        varsta ? `Vârsta copilului: ${varsta}` : "",
        `Telefon: ${telefon}`,
        descriere ? `Pe scurt: ${descriere}` : "",
      ].filter(Boolean);

      const adresa = `https://wa.me/${numar}?text=${encodeURIComponent(randuri.join("\n"))}`;
      reia.href = adresa;
      window.open(adresa, "_blank", "noopener");

      form.hidden = true;
      confirmare.hidden = false;
      confirmare.focus();
    });
  }
</script>
