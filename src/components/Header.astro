---
import { site, nav, waLink, u } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/95 backdrop-blur">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <a href={u("/")} class="flex flex-col leading-none">
      <span class="font-serif text-[1.08rem] tracking-tight sm:text-[1.32rem] md:text-[1.45rem]">
        {site.nume}
      </span>
      <span class="mt-1 text-[0.72rem] uppercase tracking-[0.14em] text-ink-soft"
        >{site.titulatura}</span
      >
    </a>

    <nav aria-label="Navigare principală" class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? "page" : undefined}
            class={`text-[0.95rem] transition-colors hover:text-mint-900 ${
              path === item.href
                ? "text-ink underline decoration-mint-300 decoration-2 underline-offset-[6px]"
                : "text-ink-soft"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.telefon.replace(/\s/g, "")}`}
        class="hidden items-center gap-1.5 text-[0.95rem] text-ink-soft transition-colors hover:text-ink md:inline-flex"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path
            d="M6.6 2h2.2c.5 0 .93.34 1.05.83l.8 3.2c.1.42-.04.86-.37 1.13l-1.4 1.16a13.4 13.4 0 0 0 5.8 5.8l1.16-1.4c.27-.33.71-.47 1.13-.37l3.2.8c.49.12.83.55.83 1.05v2.2c0 1.1-.9 2-2 2C10.5 18.4 5.6 13.5 4.6 4c0-1.1.9-2 2-2Z"
          ></path>
        </svg>
        {site.telefonAfisat}
      </a>
      <a
        href={waLink(`Bună ziua, aș dori o programare la cabinet.`)}
        class="btn btn-primary hidden sm:inline-flex"
        target="_blank"
        rel="noopener">Programează o discuție</a
      >
      <a
        href={waLink("Bună ziua, aș dori o programare la cabinet.")}
        target="_blank"
        rel="noopener"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line sm:hidden"
        aria-label="Scrieți-mi pe WhatsApp"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.79.97-.14.16-.29.19-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.5 7.5 0 0 1-1.37-1.71c-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z"
          />
        </svg>
      </a>
      <button
        type="button"
        id="meniu-buton"
        class="-mr-1 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line lg:hidden"
        aria-expanded="false"
        aria-controls="meniu-mobil"
      >
        <span class="sr-only">Deschide meniul</span>
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true" fill="none">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="meniu-mobil" hidden class="border-t border-line bg-paper lg:hidden">
    <nav aria-label="Navigare mobilă" class="wrap flex flex-col py-2">
      {
        nav.map((item) => (
          <a href={item.href} class="border-b border-line/70 py-3.5 text-[1.05rem] last:border-0">
            {item.label}
          </a>
        ))
      }
      <a
        href={waLink("Bună ziua, aș dori o programare la cabinet.")}
        class="btn btn-primary my-4"
        target="_blank"
        rel="noopener">Programează o discuție</a
      >
    </nav>
  </div>
</header>

<script>
  const buton = document.getElementById("meniu-buton");
  const meniu = document.getElementById("meniu-mobil");

  buton?.addEventListener("click", () => {
    const deschis = buton.getAttribute("aria-expanded") === "true";
    buton.setAttribute("aria-expanded", String(!deschis));
    if (meniu) meniu.hidden = deschis;
  });
</script>
