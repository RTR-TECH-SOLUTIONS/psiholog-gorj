---
import Layout from "../layouts/Layout.astro";
import { site, waLink, u } from "../data/site";
---

<Layout
  title={`Contact și programări · ${site.nume}, ${site.oras}`}
  description={`Cabinet de psihologie pentru copii în ${site.oras}, ${site.judet}. Programări la telefon, pe WhatsApp sau prin formular.`}
>
  <section class="border-b border-line bg-mint-50">
    <div class="wrap py-14 md:py-20">
      <h1 class="h1 max-w-[14ch]">Programări</h1>
      <p class="lead mt-5 max-w-2xl">
        Cel mai simplu este să sunați. Dacă vă e mai ușor să scrieți, folosiți WhatsApp sau
        formularul de mai jos, iar eu vă răspund în aceeași zi lucrătoare.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="btn btn-primary" href={`tel:${site.telefon.replace(/\s/g, "")}`}
          >Sunați la {site.telefonAfisat}</a
        >
        <a
          class="btn btn-ghost"
          href={waLink("Bună ziua, aș dori o programare la cabinet.")}
          target="_blank"
          rel="noopener">Scrieți pe WhatsApp</a
        >
      </div>
    </div>
  </section>

  <section class="wrap py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div>
        <h2 class="h2">Scrieți-mi câteva rânduri</h2>
        <p class="mt-4 max-w-xl text-ink-soft">
          Nu am nevoie de detalii medicale în mesaj. Îmi este de ajuns vârsta copilului și ce ați
          observat, restul discutăm la telefon.
        </p>

        <form id="formular" class="mt-8 grid gap-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="block text-[0.92rem]" for="nume">Numele dumneavoastră</label>
              <input
                class="mt-2 w-full rounded-btn border border-line bg-paper px-3.5 py-2.5 outline-none focus:border-mint-500"
                type="text"
                id="nume"
                name="nume"
                required
                autocomplete="name"
              />
            </div>
            <div>
              <label class="block text-[0.92rem]" for="telefon">Telefon</label>
              <input
                class="mt-2 w-full rounded-btn border border-line bg-paper px-3.5 py-2.5 outline-none focus:border-mint-500"
                type="tel"
                id="telefon"
                name="telefon"
                required
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="block text-[0.92rem]" for="email"
                >E-mail <span class="text-ink-soft">(opțional)</span></label
              >
              <input
                class="mt-2 w-full rounded-btn border border-line bg-paper px-3.5 py-2.5 outline-none focus:border-mint-500"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
              />
            </div>
            <div>
              <label class="block text-[0.92rem]" for="tip">Programarea este pentru</label>
              <select
                class="mt-2 w-full rounded-btn border border-line bg-paper px-3.5 py-2.5 outline-none focus:border-mint-500"
                id="tip"
                name="tip"
              >
                <option>Un copil</option>
                <option>Discuție doar cu părinții</option>
                <option>Un adult</option>
                <option>Încă nu știu</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-[0.92rem]" for="mesaj">Ce ați observat</label>
            <textarea
              class="mt-2 w-full rounded-btn border border-line bg-paper px-3.5 py-2.5 outline-none focus:border-mint-500"
              id="mesaj"
              name="mesaj"
              rows="5"
              required
              placeholder="De exemplu: băiat de 3 ani, spune în jur de 15 cuvinte, la grădiniță nu vorbește deloc."></textarea>
          </div>

          <p id="eroare" hidden class="text-[0.92rem] text-clay">
            Vă rog completați numele, telefonul și câteva rânduri despre situație.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <button class="btn btn-primary" type="submit">Trimite mesajul</button>
            <p class="text-[0.86rem] text-ink-soft">
              Datele rămân confidențiale și nu sunt folosite în alt scop.
            </p>
          </div>

          <p
            id="succes"
            hidden
            role="status"
            class="rounded-card border border-mint-300 bg-mint-50 px-4 py-3 text-[0.95rem]"
          >
            Mulțumesc, am primit mesajul. Vă sun în aceeași zi lucrătoare, în intervalul orar în
            care lucrez.
          </p>
        </form>
      </div>

      <aside>
        <div class="rounded-card border border-line p-6 md:p-8">
          <h2 class="font-serif text-[1.45rem]">Cabinetul</h2>
          <address class="mt-4 not-italic leading-relaxed text-ink-soft">
            {site.adresa}<br />
            {site.judet}
          </address>
          <p class="mt-4 leading-relaxed">
            <a class="link-u" href={`tel:${site.telefon.replace(/\s/g, "")}`}>{site.telefonAfisat}</a
            ><br />
            <a class="link-u" href={`mailto:${site.email}`}>{site.email}</a>
          </p>

          <h3 class="mt-8 font-serif text-[1.15rem]">Program</h3>
          <ul class="mt-3">
            {
              site.program.map((p) => (
                <li class="flex justify-between gap-6 border-b border-line py-2 text-[0.96rem] last:border-0">
                  <span>{p.zi}</span>
                  <span class="text-ink-soft">{p.ore}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-[0.9rem] text-ink-soft">
            În timpul ședințelor nu răspund la telefon. Dacă nu vă răspund, lăsați un mesaj și vă
            sun eu.
          </p>
        </div>

        <img
          src={u("/images/contact-intrare.webp")}
          width="1800"
          height="1005"
          alt="Intrarea în cabinet: ușă din lemn deschisă, o banchetă și o plantă mare"
          loading="lazy"
          class="mt-6 aspect-[16/9] w-full rounded-card object-cover"
        />
      </aside>
    </div>
  </section>

  <section class="border-t border-line bg-mint-50 py-16 md:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-14">
      <div>
        <h2 class="h2">Cum ajungeți</h2>
        <p class="mt-4 text-ink-soft">
          Cabinetul este în centrul orașului {site.oras}, la câteva minute de mers pe jos de Parcul
          Central.
        </p>

        <ul class="mt-7">
          <li class="border-t border-mint-300 py-3.5">
            <p class="font-serif text-[1.05rem]">Parcare</p>
            <p class="mt-1 text-[0.95rem] text-ink-soft">
              Loc de parcare pe stradă, în fața clădirii, de obicei liber în intervalul ședințelor.
            </p>
          </li>
          <li class="border-t border-mint-300 py-3.5">
            <p class="font-serif text-[1.05rem]">Intrarea</p>
            <p class="mt-1 text-[0.95rem] text-ink-soft">
              Intrarea este din stradă, la parter. Nu aveți scări de urcat cu căruciorul.
            </p>
          </li>
          <li class="border-t border-b border-mint-300 py-3.5">
            <p class="font-serif text-[1.05rem]">Sala de așteptare</p>
            <p class="mt-1 text-[0.95rem] text-ink-soft">
              Există o zonă separată unde pot aștepta frații sau al doilea părinte.
            </p>
          </li>
        </ul>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            class="btn btn-primary"
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.adresa)}`}
            target="_blank"
            rel="noopener">Google Maps</a
          >
          <a
            class="btn btn-ghost"
            href={`https://waze.com/ul?q=${encodeURIComponent(site.adresa)}`}
            target="_blank"
            rel="noopener">Waze</a
          >
        </div>
      </div>

      <div class="overflow-hidden rounded-card border border-line bg-paper">
        <!-- TODO(real): de înlocuit cu coordonatele exacte ale cabinetului -->
        <iframe
          class="block h-[20rem] w-full md:h-[27rem]"
          title={`Harta cu localizarea cabinetului în ${site.oras}`}
          loading="lazy"
          src="https://www.openstreetmap.org/export/embed.html?bbox=23.2647%2C45.0295%2C23.2847%2C45.0395&layer=mapnik&marker=45.0345%2C23.2747"
        ></iframe>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-5 py-4">
          <address class="not-italic text-[0.95rem]">{site.adresa}</address>
          <a class="link-u text-[0.92rem]" href={`tel:${site.telefon.replace(/\s/g, "")}`}
            >{site.telefonAfisat}</a
          >
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // TODO(real): la proiectul final, trimitere prin Resend sau salvare în Supabase.
  const formular = document.getElementById("formular") as HTMLFormElement | null;
  const succes = document.getElementById("succes");
  const eroare = document.getElementById("eroare");

  formular?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    const date = new FormData(formular);
    const nume = String(date.get("nume") ?? "").trim();
    const telefon = String(date.get("telefon") ?? "").trim();
    const mesaj = String(date.get("mesaj") ?? "").trim();

    const valid = nume.length > 1 && telefon.replace(/\D/g, "").length >= 9 && mesaj.length > 9;

    if (eroare) eroare.hidden = valid;
    if (!valid) return;

    formular.reset();
    if (succes) {
      succes.hidden = false;
      succes.scrollIntoView({ block: "center", behavior: "smooth" });
    }
  });
</script>
