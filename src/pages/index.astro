---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import portretAna from "../assets/portret-ana.webp";
import portretAnaLat from "../assets/portret-ana-lat.webp";
import cabinetAnsamblu from "../assets/cabinet-ansamblu.webp";
import cabinetMateriale from "../assets/cabinet-materiale.webp";
import sedinteOnline from "../assets/sedinte-online.webp";
import AntetText from "../components/AntetText.astro";
import AntetValuri from "../components/AntetValuri.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import { site, waLink, u } from "../data/site";
import { servicii } from "../data/servicii";

const principale = servicii.filter((s) => s.imagine);
const secundare = servicii.filter((s) => !s.imagine);

// Textele de pe pagină sunt ale clientei, exact cum le-a trimis pe WhatsApp
// (vezi materiale-primite.md din dosarul contractului). Singurele intervenții
// sunt diacriticele și greșelile evidente de tastare.

// Hero-ul are două decupaje din aceeași fotografie. Pe ecrane late cadrul e mai
// mult lat decât înalt, așa că acolo intră varianta cu toată încăperea; sub
// 1280px rămâne decupajul apropiat, altfel pe telefon s-ar vedea doar camera.
const portretLat = await getImage({
  src: portretAnaLat,
  widths: [900, 1120],
  format: "webp",
});

// Recenzii lăsate de părinți pe La-Psiholog.ro, trimise de clientă pe 23 octombrie.
// Textele sunt preluate cuvânt cu cuvânt, cu prenumele afișat acolo și luna recenziei.
const testimoniale = [
  {
    text: "O persoană minunată, răbdătoare și de încredere, care oferă căldură și grijă reală copiilor. Atmosfera este pozitivă, comunicarea cu părinții foarte bună, iar impactul asupra dezvoltării copilului meu este clar vizibil. Recomand din suflet.",
    autor: "Bianca, februarie 2026",
  },
  {
    text: "Un pedagog de recuperare minunat, cu mult suflet și răbdare. Copilul meu a evoluat enorm și vine cu drag la ședințe. Recomand din toată inima!",
    autor: "Auraș, februarie 2026",
  },
  {
    text: "O persoană dedicată, rezultate vizibile și o atmosferă primitoare.",
    autor: "Nicusor, ianuarie 2026",
  },
];

// Răspunsurile sunt frazele ei, din mesajele din 20, 21 și 23 octombrie.
const intrebari = [
  {
    q: "Care este programul cabinetului?",
    a: "Luni - Vineri: 16:00-20:00 (ideal pentru orele de după școală sau grădiniță). Weekend (Sâmbătă-Duminică): disponibilitate pe bază de programare stabilită în avans. Toate vizitele în cadrul cabinetului se fac exclusiv cu programare prealabilă, pentru a asigura un mediu liniștit și atenție deplină fiecărui copil.",
  },
  {
    q: "Ședințele se țin și online?",
    a: "Ședințele se desfășoară atât la cabinet, cât și online, în funcție de nevoile fiecărei persoane și de specificul intervenției. Toate ședințele se realizează pe bază de programare.",
  },
  {
    q: "Cum vă contactează părinții?",
    a: "Mă pot contacta direct prin telefon sau WhatsApp.",
  },
  {
    q: "Prima întâlnire se taxează?",
    a: "Ședințele se desfășoară contra cost, inclusiv prima întâlnire. Plata se face în numerar, prin transfer sau cu cardul. Plata se face la sfârșitul fiecărei ședințe.",
  },
];
---

<Layout
  title={`Psiholog copii ${site.oras} · Cabinet ${site.nume}`}
  description={`Cabinet de psihologie pentru copii în ${site.oras}, ${site.judet}: evaluare și terapie logopedică, terapia VML și terapie ABA. Programări la telefon sau pe WhatsApp.`}
  intrebari={intrebari}
>
  {/* Hero. Blocul de text stă în AntetText.astro, ca să fie exact același și pe pagina
      cu modele. Fondul crem, valurile bej și textul maro vin din macheta clientei. */}
  <section class="relative overflow-hidden bg-cream">
    <AntetValuri />

    <div class="relative mx-auto grid max-w-[110rem] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1fr)]">
      <div class="order-2 flex items-center lg:order-1">
        <div
          class="w-full px-5 py-12 md:px-10 lg:py-24 xl:pl-[clamp(2.5rem,calc((100vw-72rem)/2),11rem)] xl:pr-16"
        >
          <AntetText id="acasa">
            <h1
              slot="titlu"
              class="mx-auto max-w-[16ch] font-script text-[2.5rem] font-medium leading-[1.25] text-cocoa md:text-[3.2rem]"
            >
              O altfel de cale către comunicare și dezvoltare
            </h1>
          </AntetText>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <picture>
          <source
            media="(min-width: 1280px)"
            srcset={portretLat.srcSet.attribute}
            sizes="52vw"
            width={portretAnaLat.width}
            height={portretAnaLat.height}
          />
          <Image
            src={portretAna}
            widths={[480, 720, 900]}
            sizes="(min-width: 1024px) 52vw, 100vw"
            alt={`${site.nume}, psiholog clinician, la biroul din cabinetul din ${site.oras}`}
            class="h-[38vh] w-full object-cover object-[center_22%] sm:h-[46vh] lg:h-full lg:min-h-[34rem]"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </section>

  {/* Bandă de încredere. Coloana cu cei peste 20 de ani a fost scoasă pe 26 octombrie:
      clienta a observat, la 10:11, că experiența se repetă. Rămâne scrisă o singură dată,
      în antet, acolo unde a cerut ea să iasă în evidență. */}
  <section class="border-b border-line">
    <div class="wrap grid gap-y-6 py-8 sm:grid-cols-2 md:grid-cols-3 md:gap-x-8 md:py-9">
      <div class="md:border-r md:border-line md:pr-8">
        <p class="font-serif text-[1.6rem] leading-none">Unu-la-unu</p>
        <p class="mt-1.5 text-[0.92rem] text-ink-soft">
          ședințe desfășurate exclusiv în regim unu-la-unu (1:1)
        </p>
      </div>
      <div class="md:border-r md:border-line md:pr-8">
        <p class="font-serif text-[1.6rem] leading-none">{site.oras}</p>
        <p class="mt-1.5 text-[0.92rem] text-ink-soft">
          {site.adresaStrada}
        </p>
      </div>
      <div>
        <p class="font-serif text-[1.6rem] leading-none">Online</p>
        <p class="mt-1.5 text-[0.92rem] text-ink-soft">
          ședințele se desfășoară atât la cabinet, cât și online
        </p>
      </div>
    </div>
  </section>

  {/* Rubrica „Cui mă adresez" a fost scoasă de pe prima pagină pe 26 octombrie, la cererea
       ei din mesajul de la 08:29: aceeași listă apare și la Servicii, în fișa terapiei ABA. */}

  {/* Servicii */}
  <section class="bg-cream py-16 md:py-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="h2">Cu ce vă pot ajuta</h2>
        <a class="link-u text-[0.98rem]" href={u("/servicii")}>Toate serviciile</a>
      </div>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
        {
          principale.map((s) => (
            <article class="flex h-full flex-col">
              <a href={u(`/servicii#${s.slug}`)} class="group block">
                <Image
                  src={s.imagine}
                  widths={[320, 480, 640, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
                  alt={s.imagineAlt}
                  loading="lazy"
                  class="aspect-[4/5] w-full rounded-card object-cover"
                />
                <h3 class="mt-5 font-serif text-[1.22rem] leading-snug">{s.titlu}</h3>
              </a>
              <p class="mt-2.5 text-[0.95rem] text-ink-soft">{s.scurt}</p>
              <a class="link-u mt-auto inline-block pt-3.5 text-[0.92rem]" href={u(`/servicii#${s.slug}`)}>
                Detalii
              </a>
            </article>
          ))
        }
      </div>

      <div
        class="mt-14 grid gap-8 border-t border-line pt-10 sm:grid-cols-2 md:gap-14"
        hidden={secundare.length === 0}
      >
        {
          secundare.map((s) => (
            <article>
              <h3 class="font-serif text-[1.22rem] leading-snug">{s.titlu}</h3>
              <p class="mt-2 text-[0.96rem] text-ink-soft">{s.scurt}</p>
              <a class="link-u mt-3 inline-block text-[0.92rem]" href={u(`/servicii#${s.slug}`)}>
                Detalii
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Spațiul. Secțiune cerută de clientă pe 26 octombrie, la 19:07, după un model pe
      care l-a trimis. La 19:12 a cerut o singură fotografie, nu două. */}
  <section class="border-y border-line bg-cream py-16 md:py-20">
    <div class="wrap text-center">
      <p class="text-[0.78rem] uppercase tracking-[0.18em] text-cocoa-light">Spațiul</p>
      <h2 class="mx-auto mt-4 max-w-[20ch] font-serif text-[2rem] leading-[1.15] text-ink md:text-[2.6rem]">
        O cameră în care <em class="text-cocoa">copilului îi vine să rămână</em>.
      </h2>

      <figure class="relative mx-auto mt-10 max-w-3xl">
        <Image
          src={cabinetAnsamblu}
          widths={[480, 720, 1080, 1440]}
          sizes="(min-width: 1024px) 48rem, 100vw"
          alt="Colțul de lucru din cabinet: rafturile cu materiale, măsuța verde pentru copii și scăunelele"
          loading="lazy"
          class="aspect-[16/10] w-full rounded-card object-cover"
        />
        <figcaption
          class="absolute bottom-4 left-4 rounded-btn bg-paper/90 px-4 py-2.5 text-left shadow-sm"
        >
          <span class="block font-serif text-[1.02rem] text-ink">Camera de terapie</span>
          <span class="block text-[0.82rem] text-ink-soft">fotografie reală din cabinet</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* Despre */}
  <section class="wrap py-16 md:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <Image
        src={cabinetMateriale}
        widths={[480, 720, 900]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        alt="Raftul din cabinet, cu jocuri de limbaj, cărți, fișe și instrumente de lucru pentru copii"
        loading="lazy"
        class="aspect-[4/5] w-full rounded-card object-cover"
      />
      <div>
        <h2 class="h2">Despre mine</h2>
        <p class="mt-5 text-ink-soft">
          În activitatea mea profesională, pun accent pe înțelegerea particularităților fiecărui
          copil, pe identificarea nevoilor sale și pe dezvoltarea abilităților care îl ajută să
          comunice, să învețe și să se adapteze mai bine în viața de zi cu zi.
        </p>
        <p class="mt-4 text-ink-soft">
          Cred cu tărie că un diagnostic nu definește limitele unui copil, ci doar stabilește
          punctul de plecare în terapie. În cabinetul meu, fiecare mic progres este o victorie
          uriașă, obținută prin răbdare, consecvență și tehnici moderne.
        </p>
        {/* Clienta a cerut pe 27 octombrie, la 07:32, ca serviciile să fie scrise cu maro. */}
        <ul class="mt-7 grid gap-x-8 gap-y-2 text-[1.02rem] text-cocoa sm:grid-cols-2">
          <li class="border-b border-line py-2">Terapia VML (limbaj motor-verbal)</li>
          <li class="border-b border-line py-2">
            Intervenții bazate pe terapia ABA (Analiza Comportamentală Aplicată)
          </li>
          <li class="border-b border-line py-2">
            Evaluare și terapia logopedică în tulburările de limbaj: de pronunție și în plan
            lexico-grafic
          </li>
          <li class="border-b border-line py-2">
            Psiholog clinician, drept de liberă practică
          </li>
        </ul>
        <a class="btn btn-ghost mt-8" href={u("/despre")}>Formarea și felul în care lucrez</a>
      </div>
    </div>
  </section>

  {/* Ședințe online */}
  <section class="bg-cream py-16 md:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-16">
      <Image
        src={sedinteOnline}
        widths={[480, 720, 1080, 1440]}
        sizes="(min-width: 1024px) 46vw, 100vw"
        alt="Ședință online: laptop deschis pe o masă de lemn, caiet de notițe alături, raft cu jucării de lemn în fundal"
        loading="lazy"
        class="aspect-[4/3] w-full rounded-card object-cover"
      />
      <div>
        <h2 class="h2 max-w-[18ch]">Ședințe online</h2>
        <p class="mt-5 max-w-xl text-ink-soft">
          Ofer posibilitatea desfășurării unor ședințe online, adaptate nevoilor și
          particularităților fiecărei persoane. Acestea pot include exerciții pentru dezvoltarea
          atenției și memoriei, gestionarea emoțiilor, dezvoltarea abilităților sociale și
          activități pentru stimularea comunicării și a limbajului.
        </p>
        <p class="mt-4 max-w-xl text-ink-soft">
          Modalitatea de lucru se stabilește individual, în funcție de vârstă, obiectivele
          intervenției și adecvarea serviciului la formatul online.
        </p>
      </div>
    </div>
  </section>

  {/* Testimoniale */}
  <section class="wrap py-16 md:py-24">
    <h2 class="h2">Ce spun părinții</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-10">
      {
        testimoniale.map((t) => (
          <figure class="border-t border-line pt-6">
            <blockquote class="font-serif text-[1.12rem] leading-relaxed md:text-[1.16rem]">
              {t.text}
            </blockquote>
            <figcaption class="mt-4 text-[0.9rem] text-ink-soft">{t.autor}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-10 text-[0.9rem] text-ink-soft">
      Recenzii lăsate de părinți pe La-Psiholog.ro, preluate ca atare.
    </p>
  </section>

  {/* FAQ */}
  <section class="wrap pb-16 md:pb-24">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <h2 class="h2">Întrebări frecvente</h2>
      <div>
        <Faq intrebari={intrebari} />
        <a class="link-u mt-6 inline-block text-[0.95rem]" href={u("/pentru-parinti")}
          >Mai multe răspunsuri, în secțiunea pentru părinți</a
        >
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
