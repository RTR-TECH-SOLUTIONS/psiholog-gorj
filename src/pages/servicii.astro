---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import CtaBand from "../components/CtaBand.astro";
import { site, waLink, u } from "../data/site";
import { servicii, publicLabels } from "../data/servicii";

const filtre = [
  { val: "toate", label: "Toate" },
  { val: "copii", label: publicLabels.copii },
  { val: "parinti", label: publicLabels.parinti },
  { val: "adulti", label: publicLabels.adulti },
];
---

<Layout
  title={`Logopedie, terapie VML și ABA pentru copii · ${site.oras}`}
  description={`Evaluare și terapie logopedică, terapia VML a limbajului și intervenția comportamentală ABA pentru copii, la cabinetul din ${site.oras}, ${site.judet}.`}
>
  {/* Titlul e cel trimis de clientă pe 26 octombrie, la 18:53. Fraza de dedesubt, scrisă
      de noi, a fost scoasă: pe site rămân numai textele ei. */}
  <section class="border-b border-line bg-cream">
    <div class="wrap py-14 md:py-20">
      <h1 class="h1 max-w-[20ch] text-cocoa">Comunicare și dezvoltare, sprijin la orice vârstă</h1>
      <p class="mt-5 text-[0.95rem] text-ink-soft">{site.nume} · {site.oras}, {site.judet}</p>
    </div>
  </section>

  <div class="wrap py-10 md:py-14">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrează serviciile">
      {
        filtre.map((f, i) => (
          <button
            type="button"
            class="filtru rounded-btn border border-line px-4 py-2 text-[0.93rem] transition-colors hover:border-mint-500 aria-[pressed=true]:border-clay aria-[pressed=true]:bg-clay aria-[pressed=true]:text-white"
            data-filtru={f.val}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <p class="sr-only" role="status" id="filtru-status"></p>

    <div class="mt-12 flex flex-col gap-16 md:gap-24">
      {
        servicii.map((s, i) => (
          <article
            id={s.slug}
            class:list={[
              "serviciu scroll-mt-28",
              s.slug === "terapia-vml" &&
                "rounded-card border border-blush-deep bg-cream px-5 py-10 md:px-10 md:py-12",
            ]}
            data-public={s.public.join(" ")}
          >
            <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
              <div class={s.imagine && i % 2 === 1 ? "lg:order-2" : ""}>
                {s.imagine ? (
                  <Image
                    src={s.imagine}
                    widths={[480, 720, 1080, 1440]}
                    sizes="(min-width: 1024px) 42vw, 100vw"
                    alt={s.imagineAlt}
                    loading="lazy"
                    class="aspect-[4/3] w-full rounded-card object-cover lg:sticky lg:top-28"
                  />
                ) : (
                  <div class="lg:sticky lg:top-28">
                    <p class="text-[0.85rem] text-mint-700">
                      {s.public.map((p) => publicLabels[p]).join(" · ")}
                    </p>
                    <h2 class="h2 mt-3">{s.titlu}</h2>
                    {s.motto && <p class="mt-2 font-serif text-[1.05rem] italic text-cocoa-light">{s.motto}</p>}
                    <p class="mt-4 font-serif text-[1.35rem] italic leading-snug text-cocoa-mid md:text-[1.6rem]">
                      {s.scurt}
                    </p>
                  </div>
                )}
              </div>

              <div>
                {s.imagine && (
                  <>
                    <p class="text-[0.85rem] text-mint-700">
                      {s.public.map((p) => publicLabels[p]).join(" · ")}
                    </p>
                    <h2 class="h2 mt-3">{s.titlu}</h2>
                    {s.motto && <p class="mt-2 font-serif text-[1.05rem] italic text-cocoa-light">{s.motto}</p>}
                    <p class="mt-4 font-serif text-[1.35rem] italic leading-snug text-cocoa-mid md:text-[1.6rem]">
                      {s.scurt}
                    </p>
                  </>
                )}

                {s.descriere?.map((paragraf) => (
                  <p class="mt-4 max-w-2xl text-ink-soft">{paragraf}</p>
                ))}

                <h3 class={`font-serif text-[1.45rem] text-cocoa ${s.imagine || s.descriere ? "mt-9" : ""}`}>
                  Cui se adresează
                </h3>
                <ul class="mt-2 max-w-2xl">
                  {s.pentruCine.map((p) => (
                    <li class="border-b border-line py-3 text-ink-soft last:border-0">
                      {p.label && <span class="text-ink">{p.label}: </span>}
                      {p.text}
                    </li>
                  ))}
                </ul>

                {s.ceUrmaresc.length > 0 && (
                  <>
                    <h3 class="mt-8 font-serif text-[1.45rem] text-cocoa">Ce urmăresc</h3>
                    <ul class="mt-2 max-w-2xl">
                      {s.ceUrmaresc.map((p) => (
                        <li class="border-b border-line py-3 text-ink-soft last:border-0">
                          {p.label && <span class="text-ink">{p.label}: </span>}
                          {p.text}
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {s.scopFinal && (
                  <>
                    <h3 class="mt-8 font-serif text-[1.45rem] text-cocoa">Care este scopul final</h3>
                    {s.scopFinal.map((paragraf) => (
                      <p class="mt-2 max-w-2xl text-ink-soft">{paragraf}</p>
                    ))}
                  </>
                )}

                {s.delaVarsta && (
                  <>
                    <h3 class="mt-8 font-serif text-[1.45rem] text-cocoa">De la ce vârstă</h3>
                    {s.delaVarsta.map((paragraf) => (
                      <p class="mt-2 max-w-2xl text-ink-soft">{paragraf}</p>
                    ))}
                  </>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p id="filtru-gol" hidden class="py-10 text-center text-ink-soft">
      Nu am servicii listate pentru această categorie.
    </p>
  </div>

  {/* Tarife */}
  {/* Clienta a confirmat pe 21 octombrie că nu vrea prețuri pe site, iar pe 23 octombrie
       modalitățile de plată. Promisiunea că prima discuție nu se taxează rămâne scoasă,
       pe aceea nu a confirmat-o. */}
  <section class="border-t border-line bg-cream py-16 md:py-20">
    <div class="wrap">
      <div class="max-w-2xl">
        <h2 class="h2 max-w-[16ch]">Tarife și programări</h2>
        <p class="mt-5 text-ink-soft">
          Ședințele se desfășoară contra cost, inclusiv prima întâlnire. Plata se face în numerar,
          prin transfer sau cu cardul. Plata se face la sfârșitul fiecărei ședințe.
        </p>
        <p class="mt-4 text-ink-soft">
          Toate vizitele în cadrul cabinetului se fac exclusiv cu programare prealabilă, pentru a
          asigura un mediu liniștit și atenție deplină fiecărui copil. Mă pot contacta direct prin
          telefon sau WhatsApp.
        </p>
        <a
          class="btn btn-ghost mt-7"
          href={waLink("Bună ziua, aș dori să știu tariful pentru o evaluare.")}
          target="_blank"
          rel="noopener">Întrebați de tarif pe WhatsApp</a
        >
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  const butoane = document.querySelectorAll<HTMLButtonElement>(".filtru");
  const articole = document.querySelectorAll<HTMLElement>(".serviciu");
  const gol = document.getElementById("filtru-gol");
  const status = document.getElementById("filtru-status");

  butoane.forEach((buton) => {
    buton.addEventListener("click", () => {
      const val = buton.dataset.filtru ?? "toate";
      butoane.forEach((b) => b.setAttribute("aria-pressed", String(b === buton)));

      let vizibile = 0;
      articole.forEach((art) => {
        const publicuri = (art.dataset.public ?? "").split(" ");
        const arata = val === "toate" || publicuri.includes(val);
        art.hidden = !arata;
        if (arata) vizibile++;
      });

      if (gol) gol.hidden = vizibile > 0;
      if (status) status.textContent = `${vizibile} servicii afișate.`;
    });
  });
</script>
