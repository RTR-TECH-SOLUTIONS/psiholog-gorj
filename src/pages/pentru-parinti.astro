---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import parintiLectura from "../assets/parinti-lectura.webp";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import { site, u } from "../data/site";
import { servicii } from "../data/servicii";

// Toate textele de pe pagină sunt ale clientei, exact cum le-a trimis pe WhatsApp
// (vezi materiale-primite.md din dosarul contractului).
//
// Anexa 1 lit. A.4 cere aici și „la ce semne merită cerută o evaluare", „cum se
// pregătește copilul pentru prima ședință" și „ce se întâmplă la evaluare".
// Pentru acestea nu a trimis niciun text, iar variantele scrise de noi pentru
// demo au fost scoase pe 25 octombrie, la cererea ei de a folosi doar textele
// ei. Secțiunile revin pe pagină în momentul în care trimite textul.

const abaTsa = servicii.find((s) => s.slug === "aba-tsa");

// „Ce urmăresc în cadrul fiecărei intervenții individualizate", 17 octombrie.
const ceUrmaresc = abaTsa?.ceUrmaresc ?? [];
const scopFinal = abaTsa?.scopFinal ?? [];

// Răspunsurile de mai jos sunt frazele ei despre vârstă (17, 18 și 19 octombrie),
// despre program și ședințele online (20 și 21 octombrie) și despre plată (23 octombrie).
const intrebari = [
  {
    q: "De la ce vârstă se poate începe terapia logopedică?",
    a: "Vârsta optimă pentru corectarea propriu-zisă a pronunției este de 3-4 ani.",
  },
  {
    q: "De la ce vârstă se poate începe terapia VML?",
    a: "Nu există o limită de vârstă. Poate fi luată în considerare în intervenția timpurie, la copiii mici, la copiii de vârstă școlară și la adulții cu apraxie verbală.",
  },
  {
    q: "De la ce vârstă se poate începe intervenția ABA?",
    a: "Intervenția poate începe de la vârste mici și poate continua la vârste mai mari, în funcție de nevoile și nivelul de dezvoltare al copilului. Fiecare program este individualizat, cu obiective stabilite în funcție de abilitățile copilului și de prioritățile familiei, urmărind progresul și dezvoltarea independenței în viața de zi cu zi.",
  },
  {
    q: "Ședințele se țin și online?",
    a: "Ofer posibilitatea desfășurării unor ședințe online, adaptate nevoilor și particularităților fiecărei persoane. Acestea pot include exerciții pentru dezvoltarea atenției și memoriei, gestionarea emoțiilor, dezvoltarea abilităților sociale și activități pentru stimularea comunicării și a limbajului. Modalitatea de lucru se stabilește individual, în funcție de vârstă, obiectivele intervenției și adecvarea serviciului la formatul online.",
  },
  {
    q: "Care este programul cabinetului?",
    a: "Luni - Vineri: 16:00-20:00 (ideal pentru orele de după școală sau grădiniță). Weekend (Sâmbătă-Duminică): disponibilitate pe bază de programare stabilită în avans. Toate vizitele în cadrul cabinetului se fac exclusiv cu programare prealabilă, pentru a asigura un mediu liniștit și atenție deplină fiecărui copil.",
  },
  {
    q: "Prima întâlnire se taxează?",
    a: "Ședințele se desfășoară contra cost, inclusiv prima întâlnire. Plata se face în numerar, prin transfer sau cu cardul. Plata se face la sfârșitul fiecărei ședințe.",
  },
  {
    q: "Cum vă contactează părinții?",
    a: "Mă pot contacta direct prin telefon sau WhatsApp.",
  },
];
---

<Layout
  title={`Pentru părinți · Cabinet psihologie copii ${site.oras}`}
  description={`Ce urmăresc în lucrul cu copilul, de la ce vârstă se poate începe fiecare terapie, programul cabinetului și răspunsuri pentru părinți, la cabinetul din ${site.oras}.`}
  intrebari={intrebari}
>
  <section class="border-b border-line bg-cream">
    <div class="wrap py-14 md:py-20">
      <h1 class="h1 max-w-[16ch]">Pentru părinți</h1>
      {/* „Părinți și bunici", ultimul punct din lista ei „Cui ne adresăm?", 17 octombrie */}
      <p class="lead mt-5 max-w-2xl">
        Terapia dă roade atunci când lucrăm împreună. De aceea, vă voi sprijini prin sesiuni de
        consiliere, training și tehnici practice, pentru ca mediul de acasă să devină cel mai bun
        spațiu de creștere. Suntem o echipă!
      </p>
    </div>
  </section>

  <section class="wrap py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 class="h2 max-w-[16ch]">Ce urmăresc în fiecare intervenție</h2>
        <p class="mt-5 text-ink-soft">
          Obiectivele se stabilesc individual, în funcție de vârsta, nivelul de dezvoltare și
          nevoile copilului.
        </p>
      </div>
      <ul>
        {
          ceUrmaresc.map((p) => (
            <li class="border-b border-line py-4 leading-relaxed text-ink-soft">
              {p.label && <span class="text-ink">{p.label}: </span>}
              {p.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <h2 class="h2 max-w-[15ch]">Care este scopul final</h2>
      <div>
        {scopFinal.map((paragraf) => <p class="max-w-2xl text-ink [&+p]:mt-4">{paragraf}</p>)}
        <a class="link-u mt-6 inline-block text-[0.95rem]" href={u("/servicii")}>
          Vedeți serviciile în detaliu
        </a>
      </div>
    </div>
  </section>

  <section class="wrap py-16 md:py-24">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <Image
        src={parintiLectura}
        widths={[480, 720, 1080]}
        sizes="(min-width: 1024px) 46vw, 100vw"
        alt="Fotoliu crem cu o carte deschisă, un pled verde împăturit și o cană de ceai pe un taburet de lemn"
        loading="lazy"
        class="aspect-[4/3] w-full rounded-card object-cover lg:sticky lg:top-28"
      />
      <div>
        <h2 class="h2">Programul și programările</h2>
        <p class="mt-5 text-ink-soft">
          Luni - Vineri: 16:00-20:00 (ideal pentru orele de după școală sau grădiniță). Weekend
          (Sâmbătă-Duminică): disponibilitate pe bază de programare stabilită în avans.
        </p>
        <p class="mt-4 text-ink-soft">{site.programNota}</p>
        <p class="mt-4 text-ink-soft">
          Ședințele se desfășoară atât la cabinet, cât și online, în funcție de nevoile fiecărei
          persoane și de specificul intervenției. Toate ședințele se realizează pe bază de
          programare.
        </p>
        <p class="mt-4 text-ink-soft">Mă pot contacta direct prin telefon sau WhatsApp.</p>
        <a class="btn btn-ghost mt-8" href={u("/contact")}>Cum ajungeți la cabinet</a>
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <h2 class="h2">Întrebări frecvente</h2>
      <Faq intrebari={intrebari} />
    </div>
  </section>

  <CtaBand />
</Layout>
