---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import portretAna from "../assets/portret-ana.webp";
import portretAnaLat from "../assets/portret-ana-lat.webp";
import AntetText from "../components/AntetText.astro";
import AntetValuri from "../components/AntetValuri.astro";
import { site } from "../data/site";

// Pagină de lucru, nu face parte din site. Clienta a cerut pe 26 octombrie, la 10:06, mai
// multe modele. Așezarea paginii rămâne aceeași la toate; se schimbă numai despărțitorul
// cu inimioară și felul titlului, adică exact ce a desenat ea în machetă.
const portretLat = await getImage({
  src: portretAnaLat,
  widths: [900, 1120],
  format: "webp",
});

const alt = `${site.nume}, psiholog clinician, la biroul din cabinetul din ${site.oras}`;

const modele = [
  {
    nr: 1,
    titlu: "Varianta 1, cea de pe site acum",
    nota: "Inimioara desenată cu linia, între două linii care se sting la capete. Titlul scris de mână.",
    ornament: "linii-inima" as const,
    fontTitlu: "mana" as const,
  },
  {
    nr: 2,
    titlu: "Varianta 2, inimioara plină",
    nota: "Aceleași linii, dar inimioara este colorată în întregime, nu doar conturată.",
    ornament: "inima-plina" as const,
    fontTitlu: "mana" as const,
  },
  {
    nr: 3,
    titlu: "Varianta 3, numai inimioara",
    nota: "Fără linii. Rămâne doar inimioara, puțin mai mare, între cele două rânduri.",
    ornament: "doar-inima" as const,
    fontTitlu: "mana" as const,
  },
  {
    nr: 4,
    titlu: "Varianta 4, linii drepte",
    nota: "Două linii drepte, subțiri, cu o inimioară mică plină la mijloc. Varianta cea mai sobră.",
    ornament: "linii-drepte" as const,
    fontTitlu: "mana" as const,
  },
  {
    nr: 5,
    titlu: "Varianta 5, titlul cu literă de carte",
    nota: "Ornamentul ca în varianta 1, dar titlul nu mai este scris de mână, ci cu litera cursivă de pe celelalte pagini.",
    ornament: "linii-inima" as const,
    fontTitlu: "serif" as const,
  },
];
---

<Layout
  title="Modele pentru partea de sus a primei pagini"
  description="Pagină de lucru cu variantele de ornament și de titlu pentru prima pagină."
  noindex={true}
>
  <section class="border-b border-line bg-mint-50">
    <div class="wrap py-12 md:py-16">
      <h1 class="h1 max-w-[20ch]">Modele pentru prima pagină</h1>
      <p class="lead mt-5 max-w-2xl">
        Mai jos este partea de sus a primei pagini, în cinci feluri. Textele, culorile,
        fotografia și așezarea sunt aceleași peste tot. Se schimbă numai ornamentul dintre
        rânduri și, la ultima, felul titlului.
      </p>
      <p class="mt-4 max-w-2xl text-ink-soft">
        Prima este cea de pe site acum. Dacă vă place alta, este de ajuns să ne scrieți numărul ei.
      </p>
      <nav class="mt-7 flex flex-wrap gap-2" aria-label="Sari la o variantă">
        {
          modele.map((m) => (
            <a
              class="rounded-btn border border-line px-4 py-2 text-[0.93rem] transition-colors hover:border-mint-500"
              href={`#varianta-${m.nr}`}
            >
              Varianta {m.nr}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    modele.map((m) => (
      <section id={`varianta-${m.nr}`} class="scroll-mt-24 border-b border-line">
        <div class="wrap py-8">
          <p class="font-serif text-[1.5rem]">{m.titlu}</p>
          <p class="mt-1.5 max-w-2xl text-[0.95rem] text-ink-soft">{m.nota}</p>
        </div>

        <div class="relative overflow-hidden border-t border-line bg-cream">
          <AntetValuri />
          <div class="relative mx-auto grid max-w-[110rem] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1fr)]">
            <div class="order-2 flex items-center lg:order-1">
              <div class="w-full px-5 py-12 md:px-10 lg:py-20">
                <AntetText id={`m${m.nr}`} ornament={m.ornament} titlu={m.fontTitlu} />
              </div>
            </div>
            <div class="order-1 lg:order-2">
              <picture>
                <source
                  media="(min-width: 1280px)"
                  srcset={portretLat.srcSet.attribute}
                  sizes="52vw"
                  width={portretAnaLat.width}
                  height={portretAnaLat.height}
                />
                <Image
                  src={portretAna}
                  widths={[480, 720, 900]}
                  sizes="(min-width: 1024px) 52vw, 100vw"
                  alt={alt}
                  class="h-[38vh] w-full object-cover object-[center_22%] sm:h-[46vh] lg:h-full lg:min-h-[32rem]"
                  loading="lazy"
                />
              </picture>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="wrap py-14">
    <p class="text-ink-soft">
      Textele rămân cele trimise de dumneavoastră, iar culorile sunt cele din macheta
      dumneavoastră. Se schimbă doar ornamentul.
    </p>
  </section>
</Layout>
